# Paths to the local 5etools clones (see `pnpm data:clone`). Relative paths resolve from the repo root.
FIVETOOLS_SRC_PATH=./5etools-data/5etools-src
FIVETOOLS_IMG_PATH=./5etools-data/5etools-img

# App runtime data: SQLite database, search index, uploads.
DATA_DIR=./var

# Backups (see the "Backups" section of README.md). BACKUP_KEEP: how many backups to keep, 1 to 1000
# (default 7; backups made from the web page are kept for 7 days before they count against it).
# BACKUP_DIR: where backup zips go (default DATA_DIR/backups). With Docker it is a path INSIDE the container (a
# relative path like the example below would be wrong there), and a folder outside the app-data volume needs a bind mount. Point it at another disk or mount so a dead
# disk or a deleted volume does not take the backups with it. The server refuses to start if it lies inside
# the web build, the uploads, the 5etools data, or is DATA_DIR itself, or if it is world-writable, or if the server's
# user cannot write in it (it then names the fix; with Docker the folder must be writable by uid 1000: chown 1000:1000).
# BACKUP_EVERY_HOURS: make a backup in the server every N hours (1 to 720; unset or 0 = off). After downtime one
# catch-up backup is made about a minute after start. Recommended: 24. An invalid value stops the server from starting.
# With Docker Compose these three are passed into the container; an empty value behaves as unset, and the shipped
# docker-compose.yml turns scheduled backups ON (24) when BACKUP_EVERY_HOURS is not set: put BACKUP_EVERY_HOURS=0
# here to turn them off. A bare install (no Docker) keeps them off unless you set it.
# BACKUP_KEEP=7
# BACKUP_EVERY_HOURS=24
# BACKUP_DIR=./var/backups

# The address people open the app at. Requests from other origins are refused, and an https:// address
# makes session cookies Secure (override with SECURE_COOKIES=1 or 0, e.g. behind a TLS proxy).
PUBLIC_URL=http://localhost:4200

# Behind a reverse proxy? Set TRUST_PROXY=1 so login rate limits use the client address from X-Forwarded-For
# (the rightmost entry). Only do this when the proxy overwrites that header; if the app port is reachable
# directly, anyone could spoof it. Off by default: limits then use the connection's address.
# TRUST_PROXY=1

# Server port
PORT=3000

# Page history (README "Configuration"): HISTORY_KEEP_ALL_DAYS (30), HISTORY_COALESCE_MINUTES (2; 0 keeps every save),
# HISTORY_MONTHLY_AFTER_DAYS (365), HISTORY_MAX_PER_PAGE (200), HISTORY_MAX_MB_PER_CAMPAIGN (500). Invalid values use the default.
# HISTORY_KEEP_ALL_DAYS=30
# HISTORY_COALESCE_MINUTES=2
